@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card-panel">
    <h1 class="titulo text-danger">Ocurrió un error</h1>
    <p>Se produjo un error al procesar la solicitud. Intente de nuevo más tarde.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mb-0"><strong>Código de solicitud:</strong> <code>@Model.RequestId</code></p>
    }
</div>
