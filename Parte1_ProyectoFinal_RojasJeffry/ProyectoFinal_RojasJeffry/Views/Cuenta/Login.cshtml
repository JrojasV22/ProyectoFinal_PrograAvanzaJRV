@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card-panel">
            <h1 class="titulo text-center mb-4">Iniciar sesión</h1>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small text-center mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label fw-bold"></label>
                    <input asp-for="Correo" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label fw-bold"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primario w-100">Ingresar</button>
            </form>

            <div class="text-center mt-3 small">
                <a asp-action="Registro">¿No tiene cuenta? Regístrese aquí</a><br />
                <a asp-controller="Home" asp-action="Carreras">Ver carreras disponibles</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
